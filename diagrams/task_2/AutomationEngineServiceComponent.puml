@startuml
!ROUNDED_STYLE=1
!include <C4/C4_Component>
!include <logos/nats>
!include <logos/postgresql>
LAYOUT_TOP_DOWN()


Container(api_gateway, "API Gateway", "Apache APISIX")
ContainerQueue(nats, "Message Broker", "Nats", "", nats)
ContainerDb(automations_postgresql, "Database", "PostgreSQL", "", postgresql)



Container_Boundary(automation_engine, "Automation Engine Service") {
    Component(automation_api, "Automation REST Controller", "FastAPI Router", "Создание, редактирование, просмотр сценариев")
    Component(automation_nats_consumer, "Telemetry Events Consumer", "NATS JetStream Consumer", "Забирает события телеметрии из брокера")


    Component(automation_service, "Automation Service", "Python", "Проверка условий сценариев и их запуск")


    Component(automation_repo, "Automation Repository", "SQLAlchemy (async)", "CRUD сценариев и правил")
    Component(automation_nats_publisher, "Command Publisher", "NATS JetStream Publisher", "Публикация команд на исполнение сервисом управления устройствами")
}



Rel(api_gateway, automation_api, "REST API")
Rel_D(nats, automation_nats_consumer, "Consume")



Rel(automation_api, automation_service, "Uses")
Rel(automation_nats_consumer, automation_service, "Uses")



Rel(automation_service, automation_repo, "Query")
Rel(automation_service, automation_nats_publisher, "Publish")



Rel(automation_repo, automations_postgresql, "SQL")
Rel_U(automation_nats_publisher, nats, "Produce")

@enduml