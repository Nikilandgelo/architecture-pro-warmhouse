@startuml
!ROUNDED_STYLE=1
!include <C4/C4_Component>
!include <logos/nats>
!include <logos/postgresql>
LAYOUT_TOP_DOWN()


AddRelTag("api_route", $textColor="cornflowerblue", $lineColor="cornflowerblue", $lineStyle = BoldLine())
AddRelTag("broker_routes", $textColor="firebrick", $lineColor="firebrick", $lineStyle = SolidLine())
AddRelTag("storage_route", $textColor="seagreen", $lineColor="seagreen", $lineStyle = DottedLine())
AddRelTag("kv_route", $textColor="darkorange", $lineColor="darkorange", $lineStyle = DashedLine())



Container(api_gateway, "API Gateway", "Apache APISIX")
ContainerQueue(nats, "Message Broker, Key & Value Store", "Nats", "", nats)
ContainerDb(automations_postgresql, "Database", "PostgreSQL", "", postgresql)



Container_Boundary(automation_engine, "Automation Engine Service") {
    Component(automation_api, "Automation REST Controller", "FastAPI Router", "Создание, редактирование, просмотр сценариев")
    Component(automation_nats_consumer, "Telemetry Events Consumer", "NATS JetStream Consumer", "Забирает события телеметрии из брокера")


    Component(ownership_dep, "Ownership Check Dependency", "FastAPI Depends", "Проверка владения устройством перед CRUD сценария")


    Component(automation_crud_service, "Automation CRUD Service", "Python", "Создание, редактирование, просмотр сценариев и правил")
    Component(automation_trigger_service, "Automation Trigger Service", "Python", "Проверка условий сценариев по событию и запуск, публикация команд")


    Component(automation_repo, "Automation Repository", "SQLAlchemy (async)", "CRUD сценариев и проверка правил для устройства")
    Component(automation_nats_publisher, "Command Publisher", "NATS JetStream Publisher", "Публикация команд на исполнение сервисом управления устройствами")
}



Rel(api_gateway, automation_api, "REST API", $tags="api_route")
Rel_D(nats, automation_nats_consumer, "Consume", $tags="broker_routes")



Rel(automation_api, ownership_dep, "Uses")
Rel_R(ownership_dep, nats, "NATS KV: Get", $tags="kv_route")
Rel(ownership_dep, automation_crud_service, "Uses")
Rel(automation_crud_service, automation_repo, "CRUD", $tags="storage_route")
Rel(automation_repo, automations_postgresql, "SQL", $tags="storage_route")




Rel(automation_nats_consumer, automation_trigger_service, "Uses")
Rel(automation_trigger_service, automation_repo, "Check device scenarios", $tags="storage_route")
Rel(automation_trigger_service, automation_nats_publisher, "Publish")
Rel_U(automation_nats_publisher, nats, "Produce", $tags="broker_routes")

@enduml
